{
  "name": "s10-telemedicine-desktop",
  "version": "1.1.0",
  "description": "Desktop application for S10 Telemedicine",
  "main": "src/main.js",
  "author": "S10 Technologies",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win nsis --linux --mac"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "in.s10.telemedicine",
    "productName": "S10 Telemedicine",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "S10 Telemedicine",
      "runAfterFinish": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.medical",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "S10 Telemedicine needs the camera for video consultations.",
        "NSMicrophoneUsageDescription": "S10 Telemedicine needs the microphone for audio and video consultations.",
        "NSScreenCaptureDescription": "S10 Telemedicine needs screen recording access to share your screen during a consultation."
      }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Office"
    }
  }
}
